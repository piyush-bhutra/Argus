# Environment variables
.env
.env.*
!.env.example

# Python virtual environments
.venv/
venv/
env/

# Python cache
__pycache__/
*.py[cod]
*.pyo

# Testing & coverage
.pytest_cache/
.coverage
htmlcov/

# Type checking
.mypy_cache/
.pyre/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# Build artifacts
build/
dist/
*.egg-info/

# Logs
logs/
*.log

# IDEs
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Local databases
*.db
*.sqlite
*.sqlite3

# Model artifacts (top-level only — NOT the app/models package)
/models/
checkpoints/
!app/models/

# Data: everything under data/ stays local by default. The exceptions below
# are small artifacts that someone cloning the repo needs.
# (gitignore has no inline comments - each note sits on its own line.)
data/*
# cached demo debates, loaded at API startup (no LLM needed)
!data/demo_debates.json
# trained calibrator, once it exists
!data/calibrator.pkl
# latest eval run: metrics, config, and per-claim scores
!data/eval_summary.json
# reliability diagrams for that same run
!data/reliability_*.png
# The held-out evaluation set. Committed because the eval cache is keyed on
# claim text: if this file is ever regenerated differently, every cached score
# silently detaches from its claim.
!data/fever_sample.json
# Pooled BM25 evidence corpus. Regenerable, but required by retrieval, by the
# symbolic fact-checker and by the deployed demo.
!data/evidence_corpus.json
# The debate artifact cache. Hours of quota-gated API time and the input to
# every rescore and every ablation - too expensive to live on one machine.
# Its .tmp / .corrupt-* siblings stay ignored.
!data/eval_results.json
# The calibration split and its scores. Committed because the leakage guard in
# fit_calibrator compares against fever_sample.json: regenerating this file
# differently would silently change what "disjoint" means.
!data/fever_calib.json
!data/calib_results.json
!data/calib_summary.json
# Reported results cited by docs/RESULTS.md.
!data/rescore_summary.json
!data/sweep_summary.json
data/eval_results.json.tmp
data/eval_results.corrupt-*
datasets/
fever_data/

# Node (frontend/.gitignore covers Vite / TanStack / Wrangler outputs:
# dist, .output, .tanstack, .nitro, .wrangler, .dev.vars)
node_modules/
coverage/

# Secrets
secrets/
*.pem
*.key

# Antigravity / AI generated temp files
*.tmp
*.bak
*.deleteme
