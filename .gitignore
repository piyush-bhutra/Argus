# Environment variables
.env
.env.*
!.env.example

# Python virtual environments
.venv/
venv/
env/

# Python cache
__pycache__/
*.py[cod]
*.pyo

# Testing & coverage
.pytest_cache/
.coverage
htmlcov/

# Type checking
.mypy_cache/
.pyre/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# Build artifacts
build/
dist/
*.egg-info/

# Logs
logs/
*.log

# IDEs
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Local databases
*.db
*.sqlite
*.sqlite3

# Model artifacts (top-level only — NOT the app/models package)
/models/
checkpoints/
!app/models/

# Data: everything under data/ stays local by default. The exceptions below
# are small artifacts that someone cloning the repo needs.
# (gitignore has no inline comments - each note sits on its own line.)
data/*
# cached demo debates, loaded at API startup (no LLM needed)
!data/demo_debates.json
# trained calibrator, once it exists
!data/calibrator.pkl
# latest eval run: metrics, config, and per-claim scores
!data/eval_summary.json
# reliability diagrams for that same run
!data/reliability_*.png
# Deliberately NOT committed, both regenerable:
#   data/fever_sample.json - python -m scripts.prepare_fever (seeded)
#   data/eval_results.json - the eval harness's resumable LLM-score cache
#                            (plus its .tmp / .corrupt-* siblings)
datasets/
fever_data/

# Node (frontend/.gitignore covers Vite / TanStack / Wrangler outputs:
# dist, .output, .tanstack, .nitro, .wrangler, .dev.vars)
node_modules/
coverage/

# Secrets
secrets/
*.pem
*.key

# Antigravity / AI generated temp files
*.tmp
*.bak
*.deleteme
