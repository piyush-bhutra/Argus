# LLM provider — any OpenAI-SDK-compatible endpoint. Pick ONE block below.

# --- Google Gemini (AI Studio) ---
# Prefer a *-flash-lite model: the newest flash models have a tiny free daily
# quota (gemini-3.6-flash = 20 requests/day). Quota is per-model, so switching
# model gives a fresh bucket. gemini-3.5-flash-lite works as of 2026-08.
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-3.5-flash-lite
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- Cerebras (free tier: 1M tokens/day, 5 req/min) ---
# LLM_API_KEY=your_cerebras_api_key_here
# LLM_MODEL=gpt-oss-120b
# LLM_BASE_URL=https://api.cerebras.ai/v1

# Where application logs are written
LOG_DIR=./logs
